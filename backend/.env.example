# Copy to `.env` and adjust if needed. ALL values are optional — the backend is
# self-contained and runs with these defaults out of the box.

# Comma-separated list of allowed frontend origins (CORS).
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Server bind address.
HOST=127.0.0.1
PORT=8000

# Data locations. DEFAULTS ARE INSIDE backend/data/ (portable) — do NOT point these
# outside the backend folder unless you deliberately relocate the bundled data.
#   raw scientific files : backend/data/raw
#   PDB structures       : backend/data/structures
#   structure index      : backend/data/processed/structure_index.csv
# Uncomment ONLY to override with an absolute path:
# DATA_DIR=/absolute/path/to/backend/data/raw
# PDB_DIR=/absolute/path/to/backend/data/structures
